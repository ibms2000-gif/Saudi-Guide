---
import locationsData from '../../data/locations.json';

export async function getStaticPaths() {
  return locationsData.map((item) => ({
    params: { 
      category: item.category, 
      slug: item.slug 
    },
    props: { item },
  }));
}

const { item } = Astro.props;
const pageTitle = `${item.h1} - ${item.regionAr} | دليل الخدمات`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle}</title>
    <meta name="description" content={item.description}>
    <link rel="canonical" href={canonicalURL}>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-900 font-sans">
    <header class="bg-white shadow-sm py-4 mb-8">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <a href="/" class="text-xl font-bold text-blue-600">الدليل الشامل pSEO</a>
            <nav class="space-x-4 space-x-reverse">
                <a href="/" class="text-gray-600 hover:text-blue-600">الرئيسية</a>
                <a href="/sitemap.xml" class="text-gray-600 hover:text-blue-600">خارطة الموقع</a>
            </nav>
        </div>
    </header>
    <main class="container mx-auto px-4 max-w-4xl">
        <article class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
            <span class="text-sm bg-blue-50 text-blue-600 px-3 py-1 rounded-full font-medium">
                {item.regionAr} - {item.categoryName}
            </span>
            <h1 class="text-3xl lg:text-4xl font-extrabold mt-4 mb-6 text-gray-900">
                {item.h1}
            </h1>
            <p class="text-lg text-gray-600 leading-relaxed mb-8">
                {item.description} نقدم لك هنا أحدث التفاصيل والمعلومات الدقيقة المحدثة حول {item.h1} في محافظة {item.nameAr} لضمان حصولك على البيانات الموثوقة فوراً.
            </p>
        </article>
        <section class="mt-12 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
            <h3 class="text-lg font-bold mb-4 text-gray-800">مناطق وخدمات مرتبطة في {item.regionAr}:</h3>
            <div class="flex flex-wrap gap-2">
                {item.adjacent && item.adjacent.map((adj) => (
                    <a href={`/${item.category}/${adj.slug}`} class="bg-gray-100 hover:bg-blue-600 hover:text-white text-gray-700 px-4 py-2 rounded-lg text-sm transition-colors duration-200">
                        {item.categoryName} في {adj.name}
                    </a>
                ))}
            </div>
        </section>
    </main>
    <footer class="mt-20 bg-white border-t border-gray-200 py-8 text-center text-gray-500 text-sm">
        <p>جميع الحقوق محفوظة © 2026 - منصة الـ pSEO الآلية</p>
    </footer>
</body>
</html>
