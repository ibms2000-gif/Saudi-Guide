---
import locationsData from '../../data/locations.json';

export async function getStaticPaths() {
  return locationsData.map((item) => ({
    params: { category: item.category, slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const categoryMeta = {
  restaurants: { name: 'المطاعم والمقاهي', icon: '☕', intro: 'استخدم البحث الخارجي للوصول إلى المطاعم والمقاهي على الخريطة. لا نعرض حاليًا قائمة منشآت أو تقييمات غير موثقة.' },
  weather: { name: 'الطقس والمناخ', icon: '☀️', intro: 'هذه الصفحة نقطة وصول لمعلومات الطقس في المدينة. لقراءة التحديثات الحالية، افتح نتائج الطقس من مصدر خارجي.' },
  services: { name: 'الخدمات والمرافق', icon: '⌖', intro: 'ابدأ بالبحث عن الخدمات والمرافق في المدينة، ثم راجع تفاصيل الجهة ومواعيدها من مصدرها قبل الزيارة.' },
};
const category = categoryMeta[item.category] ?? { name: item.categoryName, icon: '⌖', intro: item.description };
const pageTitle = item.h1 + ' | دليل السعودية';
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const maps = new URL('https://www.google.com/maps/search/');
maps.searchParams.set('api', '1');
maps.searchParams.set('query', item.category === 'restaurants' ? 'مطاعم ومقاهي ' + item.nameAr : item.category === 'services' ? 'الخدمات والمرافق ' + item.nameAr : 'الطقس ' + item.nameAr);
const search = new URL('https://www.google.com/search');
search.searchParams.set('q', item.category === 'weather' ? 'حالة الطقس اليوم ' + item.nameAr : item.category === 'services' ? 'الخدمات والمرافق ' + item.nameAr : 'مطاعم ومقاهي ' + item.nameAr);
const relatedItems = (item.adjacent ?? []).map((adj) => {
  const match = locationsData.find((candidate) => candidate.slug === adj.slug && candidate.category === item.category)
    ?? locationsData.find((candidate) => candidate.slug === adj.slug);
  return match ? { ...match, displayName: adj.name || match.nameAr } : null;
}).filter(Boolean);
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: category.name, item: new URL('/#categories', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: item.nameAr, item: canonicalURL },
  ],
};
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  url: canonicalURL,
  inLanguage: 'ar-SA',
  description: item.description,
  isPartOf: { '@type': 'WebSite', name: 'دليل السعودية', url: new URL('/', Astro.site).toString() },
};
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#123b32" />
  <title>{pageTitle}</title>
  <meta name="description" content={item.description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ar_SA" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={item.description} />
  <meta property="og:url" content={canonicalURL} />
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <style>
    :root{--green:#123b32;--green2:#1e5a49;--gold:#d5b779;--ink:#192b26;--muted:#66756e;--paper:#f6f8f4;--line:#e0e7df;--mint:#eaf2eb}
    *{box-sizing:border-box}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:Tahoma,"Segoe UI",Arial,sans-serif;line-height:1.8}
    a{color:inherit;text-decoration:none}
    a:focus-visible{outline:3px solid #b98935;outline-offset:3px}
    .container{width:min(1080px,calc(100% - 36px));margin-inline:auto}
    .header{background:#fff;border-bottom:1px solid var(--line)}
    .nav{height:74px;display:flex;align-items:center;justify-content:space-between;gap:20px}
    .brand{display:flex;align-items:center;gap:11px;font-size:18px;font-weight:800}
    .mark{height:40px;width:40px;display:grid;place-items:center;border-radius:13px;background:var(--green);color:#efdba8;font-size:23px}
    .brand b{color:var(--green2)}
    .nav-links{display:flex;gap:23px;color:var(--muted);font-size:13px}
    .nav-links a:hover{color:var(--green2)}
    .hero{background:var(--green);color:#fff;padding:39px 0 54px}
    .crumbs{display:flex;gap:9px;flex-wrap:wrap;align-items:center;color:#d5e2d9;font-size:12px;margin-bottom:28px}
    .crumbs a:hover{color:#fff}
    .crumbs .sep{opacity:.6}
    .eyebrow{display:inline-flex;align-items:center;gap:8px;color:#ead8a8;font-size:12px;font-weight:800}
    .eyebrow-icon{display:inline-grid;place-items:center;width:32px;height:32px;border-radius:10px;background:#ffffff18;font-size:19px}
    h1{font-size:clamp(29px,4.2vw,45px);line-height:1.35;letter-spacing:-.7px;margin:13px 0 12px;max-width:800px}
    .lead{max-width:800px;color:#d8e4dd;margin:0;font-size:15px}
    .content{padding:32px 0 72px}
    .layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(250px,.8fr);gap:22px;align-items:start}
    .panel{background:#fff;border:1px solid var(--line);border-radius:19px;padding:25px}
    .panel h2{font-size:21px;line-height:1.5;margin:0 0 9px}
    .muted{color:var(--muted);font-size:13px;margin:0}
    .action-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:22px}
    .action{display:flex;align-items:center;gap:12px;border:1px solid var(--line);border-radius:14px;padding:15px;transition:border-color .2s,transform .2s;background:#fff}
    .action:hover{border-color:#adc4b3;transform:translateY(-2px)}
    .action-icon{width:43px;height:43px;flex:0 0 43px;display:grid;place-items:center;background:var(--mint);border-radius:13px;color:var(--green);font-size:22px}
    .action strong{display:block;font-size:13px;line-height:1.6}
    .action small{display:block;color:var(--muted);font-size:11px;line-height:1.6;margin-top:2px}
    .notice{display:flex;gap:12px;background:#f7f7f1;border:1px solid #e8e3d4;border-radius:14px;padding:15px;margin-top:19px;color:#5e5b4d;font-size:12px}
    .notice-icon{font-size:19px;line-height:1.4}
    .side-panel{background:#fff;border:1px solid var(--line);border-radius:19px;padding:23px}
    .side-panel h2{font-size:17px;margin:0 0 13px}
    .city-fact{display:flex;justify-content:space-between;gap:10px;padding:11px 0;border-bottom:1px solid #edf0eb;font-size:12px}
    .city-fact:last-child{border-bottom:0}
    .city-fact span{color:var(--muted)}
    .city-fact strong{text-align:left}
    .related{margin-top:22px}
    .related h2{font-size:20px;margin:0 0 14px}
    .related-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .related-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:15px;transition:border-color .2s,transform .2s}
    .related-card:hover{border-color:#adc4b3;transform:translateY(-2px)}
    .related-card small{display:block;color:var(--muted);font-size:11px}
    .related-card strong{display:block;margin-top:5px;font-size:14px}
    .related-arrow{display:block;color:var(--green2);margin-top:7px;font-size:12px}
    .back-link{display:inline-flex;align-items:center;gap:8px;margin-top:20px;color:var(--green2);font-size:13px;font-weight:800}
    footer{background:#102f29;color:#d3e1d8;padding:25px 0;font-size:12px}
    .footer-inner{display:flex;justify-content:space-between;gap:16px;align-items:center}
    footer p{margin:3px 0 0;color:#b4c8bc}
    @media(max-width:760px){.layout{grid-template-columns:1fr}.nav-links{gap:12px}.hero{padding:28px 0 38px}.crumbs{margin-bottom:21px}.panel,.side-panel{padding:20px}.related-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:480px){.container{width:calc(100% - 26px)}.nav{height:66px}.brand{font-size:16px}.mark{height:36px;width:36px}.nav-links{font-size:11px;gap:10px}.action-grid{grid-template-columns:1fr}.related-grid{grid-template-columns:1fr}.footer-inner{align-items:flex-start;flex-direction:column}h1{font-size:30px}}
    @media(prefers-reduced-motion:reduce){*,*:before,*:after{transition:none!important}}
  </style>
</head>
<body>
  <header class="header">
    <div class="container nav">
      <a class="brand" href="/" aria-label="دليل السعودية - الصفحة الرئيسية"><span class="mark" aria-hidden="true">س</span><span>دليل <b>السعودية</b></span></a>
      <nav class="nav-links" aria-label="التنقل الرئيسي"><a href="/">الرئيسية</a><a href="/#categories">الأقسام</a><a href="/sitemap.xml">خريطة الموقع</a></nav>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <nav class="crumbs" aria-label="مسار التنقل">
        <a href="/">الرئيسية</a><span class="sep" aria-hidden="true">/</span>
        <a href="/#categories">{category.name}</a><span class="sep" aria-hidden="true">/</span>
        <span aria-current="page">{item.nameAr}</span>
      </nav>
      <div class="eyebrow"><span class="eyebrow-icon" aria-hidden="true">{category.icon}</span>{item.regionAr} · {category.name}</div>
      <h1>{item.h1}</h1>
      <p class="lead">{item.description}</p>
    </div>
  </section>

  <main class="container content">
    <div class="layout">
      <section class="panel">
        <h2>ابدأ من هنا</h2>
        <p class="muted">{category.intro}</p>
        <div class="action-grid">
          <a class="action" href={maps.toString()} target="_blank" rel="noopener noreferrer">
            <span class="action-icon" aria-hidden="true">⌖</span>
            <span><strong>{item.category === 'weather' ? 'اعثر على موقع المدينة' : item.category === 'services' ? 'ابحث عن الخدمات على الخريطة' : 'ابحث عن الأماكن على الخريطة'}</strong><small>يفتح Google Maps في نافذة جديدة</small></span>
          </a>
          <a class="action" href={search.toString()} target="_blank" rel="noopener noreferrer">
            <span class="action-icon" aria-hidden="true">{item.category === 'weather' ? '☀' : '↗'}</span>
            <span><strong>{item.category === 'weather' ? 'استعرض تحديثات الطقس' : 'اعرض نتائج بحث إضافية'}</strong><small>راجع المصدر والتوقيت قبل الاعتماد على النتائج</small></span>
          </a>
        </div>
        <div class="notice"><span class="notice-icon" aria-hidden="true">ⓘ</span><span>للمحافظة على دقة المعلومات، لا يعرض دليل السعودية حاليًا تقييمات أو أسماء منشآت أو درجات حرارة غير متصلة بمصدر موثوق. قد تتغير نتائج المواقع الخارجية ومواعيد الجهات.</span></div>
        <a class="back-link" href="/">← العودة إلى الصفحة الرئيسية</a>
      </section>

      <aside class="side-panel" aria-label="معلومات الصفحة">
        <h2>عن هذه الصفحة</h2>
        <div class="city-fact"><span>المدينة</span><strong>{item.nameAr}</strong></div>
        <div class="city-fact"><span>المنطقة</span><strong>{item.regionAr}</strong></div>
        <div class="city-fact"><span>القسم</span><strong>{category.name}</strong></div>
        <div class="city-fact"><span>نوع المعلومات</span><strong>دليل وروابط إرشادية</strong></div>
      </aside>
    </div>

    {relatedItems.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <h2 id="related-heading">مدن وصفحات ذات صلة</h2>
        <div class="related-grid">
          {relatedItems.map((related) => (
            <a class="related-card" href={'/' + related.category + '/' + related.slug}>
              <small>{related.regionAr}</small>
              <strong>{related.displayName}</strong>
              <span class="related-arrow">{categoryMeta[related.category]?.name ?? related.categoryName} ←</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <footer><div class="container footer-inner"><div><strong>دليل السعودية</strong><p>بوابة إرشادية لاكتشاف مدن المملكة.</p></div><div>© {new Date().getFullYear()} دليل السعودية</div></div></footer>
</body>
</html>
