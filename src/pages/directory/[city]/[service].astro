---
import cities from '../../../data/cities.json';
import services from '../../../data/service-types.json';

export function getStaticPaths() {
  return cities.flatMap((city) => services.map((service) => ({
    params: { city: city.slug, service: service.slug },
    props: { city, service }
  })));
}

const { city, service } = Astro.props;
const fill = (template) => template.replaceAll('{city}', city.nameAr).replaceAll('{region}', city.regionAr);
const pageTitle = fill(service.titleTemplate);
const description = fill(service.descriptionTemplate) + ' ' + city.overview;
const canonicalURL = new URL(`/directory/${city.slug}/${service.slug}/`, Astro.site).toString();
const homeURL = new URL('/', Astro.site).toString();
const cityURL = new URL(`/city/${city.slug}/`, Astro.site).toString();
const serviceURL = new URL(`/services/${service.slug}/`, Astro.site).toString();
const nearbyCities = cities.filter((other) => other.slug !== city.slug && other.regionAr === city.regionAr).slice(0, 5);
const relatedServices = services.filter((other) => other.slug !== service.slug).slice(0, 4);
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description,
  url: canonicalURL,
  inLanguage: 'ar-SA',
  isPartOf: { '@type': 'WebSite', name: 'دليل السعودية', url: homeURL },
  about: { '@type': 'City', name: city.nameAr, containedInPlace: { '@type': 'AdministrativeArea', name: city.regionAr } }
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: homeURL },
    { '@type': 'ListItem', position: 2, name: 'مدن السعودية', item: cityURL },
    { '@type': 'ListItem', position: 3, name: city.nameAr, item: cityURL },
    { '@type': 'ListItem', position: 4, name: service.nameAr, item: canonicalURL }
  ]
};
---

<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#123b32" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ar_SA" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <script type="application/ld+json" set:html={JSON.stringify(pageSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <style>
    :root{--green:#123b32;--green2:#1d5a49;--gold:#d5b779;--ink:#182c26;--muted:#63736b;--paper:#f6f8f4;--line:#e0e7df;--mint:#eaf2eb}
    *{box-sizing:border-box}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:Tahoma,"Segoe UI",Arial,sans-serif;line-height:1.8}
    a{color:inherit;text-decoration:none}
    a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #b98935;outline-offset:3px}
    button,input{font:inherit}
    .container{width:min(1120px,calc(100% - 32px));margin-inline:auto}
    .header{background:#fff;border-bottom:1px solid var(--line)}
    .nav{height:70px;display:flex;align-items:center;justify-content:space-between;gap:18px}
    .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px}
    .mark{height:39px;width:39px;border-radius:13px;background:var(--green);color:#efdba8;display:grid;place-items:center;font-size:23px}
    .brand b{color:var(--green2)}
    .navlinks{display:flex;gap:18px;font-size:13px;color:var(--muted)}
    .hero{background:var(--green);color:#fff;padding:35px 0 43px}
    .crumbs{display:flex;gap:8px;flex-wrap:wrap;color:#d1e0d7;font-size:12px;margin-bottom:23px}
    .crumbs a:hover{color:#fff}
    .eyebrow{color:#ead8a6;font-size:13px;font-weight:800;display:flex;align-items:center;gap:8px}
    h1{font-size:clamp(30px,4vw,44px);line-height:1.36;letter-spacing:-.6px;margin:13px 0 12px}
    .lead{max-width:850px;color:#d7e4dc;font-size:15px;margin:0}
    .main{padding:30px 0 64px}
    .layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:20px;align-items:start}
    .panel{min-width:0;background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px}
    .panel h2{font-size:21px;line-height:1.5;margin:0 0 5px}
    .muted{color:var(--muted);font-size:13px;margin:0}
    .toolbar{display:flex;gap:10px;align-items:center;margin-top:20px}
    .search{flex:1;min-width:0;border:1px solid #dbe4da;border-radius:11px;padding:12px 14px;background:#fff;color:var(--ink)}
    .refresh{border:0;border-radius:11px;background:var(--green);color:#fff;padding:12px 15px;cursor:pointer;font-weight:800;font-size:13px}
    .refresh:hover{background:var(--green2)}
    .filters{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
    .filter{border:1px solid var(--line);border-radius:99px;background:#fff;color:var(--muted);padding:6px 12px;font-size:12px;cursor:pointer}
    .filter[aria-pressed="true"]{background:var(--green);border-color:var(--green);color:#fff}
    .resultsmeta{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:18px 0 12px;color:var(--muted);font-size:12px}
    .results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    .place{display:flex;flex-direction:column;min-width:0;border:1px solid var(--line);border-radius:14px;padding:15px;background:#fff}
    .place h3{font-size:15px;line-height:1.55;margin:0 0 5px}
    .kind{align-self:flex-start;background:var(--mint);color:var(--green2);font-size:11px;border-radius:6px;padding:3px 8px;margin-bottom:8px}
    .place p{margin:0 0 7px;color:var(--muted);font-size:12px;line-height:1.7;overflow-wrap:anywhere}
    .details{display:flex;flex-wrap:wrap;gap:9px;margin-top:auto;padding-top:9px}
    .details a{font-size:12px;font-weight:800;color:var(--green2)}
    .details a:hover{text-decoration:underline}
    .status{border:1px dashed #d5ded3;background:#fafbf8;border-radius:13px;padding:24px;text-align:center;color:var(--muted);font-size:13px}
    .status strong{display:block;color:var(--ink);font-size:15px;margin-bottom:5px}
    .notice{margin-top:14px;font-size:11px;color:var(--muted);line-height:1.8}
    .sidebar{display:grid;gap:14px}
    .side{background:#fff;border:1px solid var(--line);border-radius:17px;padding:19px}
    .side h2{font-size:16px;margin:0 0 10px}
    .fact{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid #edf0eb;font-size:12px}
    .fact:last-child{border-bottom:0}
    .fact span{color:var(--muted)}
    .side-links{display:grid;gap:9px}
    .side-links a{font-size:13px;color:var(--green2);font-weight:700}
    .side-links a:hover{text-decoration:underline}
    .weather-current{display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--mint);border-radius:15px;padding:17px;margin-top:18px}
    .temperature{font-size:40px;line-height:1.2;font-weight:800;color:var(--green)}
    .weather-description{font-size:12px;color:var(--muted);margin-top:5px}
    .weather-symbol{font-size:38px}
    .weather-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:12px}
    .wstat{border:1px solid var(--line);border-radius:12px;padding:12px;text-align:center}
    .wstat strong{display:block;font-size:17px;color:var(--green)}
    .wstat span{font-size:11px;color:var(--muted)}
    .hourly{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:12px}
    .hour{background:#fafbf8;border:1px solid var(--line);border-radius:11px;padding:9px 5px;text-align:center}
    .hour span{display:block;color:var(--muted);font-size:10px}
    .hour strong{font-size:14px}
    .related{margin-top:23px}
    .related h2{font-size:20px;margin:0 0 12px}
    .linkgrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
    .linkcard{background:#fff;border:1px solid var(--line);border-radius:12px;padding:13px;font-size:12px;transition:border-color .2s}
    .linkcard:hover{border-color:#a8c1ad}
    .linkcard strong{display:block}
    .linkcard small{display:block;color:var(--muted);margin-top:4px}
    footer{background:#102f29;color:#d4e2d9;padding:23px 0;font-size:12px}
    .foot{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
    @media(max-width:840px){.layout{grid-template-columns:1fr}.sidebar{grid-template-columns:1fr 1fr}.linkgrid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:560px){.container{width:calc(100% - 24px)}.nav{height:63px}.brand{font-size:16px}.navlinks{gap:10px;font-size:11px}.hero{padding:25px 0 32px}.crumbs{margin-bottom:17px}.panel{padding:17px}.toolbar{flex-direction:column;align-items:stretch}.refresh{width:100%}.results{grid-template-columns:1fr}.sidebar{grid-template-columns:1fr}.hourly{grid-template-columns:repeat(3,minmax(0,1fr))}.linkgrid{grid-template-columns:1fr 1fr}h1{font-size:30px}}
    @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
  </style>
</head>
<body>
<header class="header"><div class="container nav">
  <a class="brand" href="/"><span class="mark">س</span><span>دليل <b>السعودية</b></span></a>
  <nav class="navlinks" aria-label="التنقل"><a href="/">الرئيسية</a><a href={cityURL}>صفحة المدينة</a><a href={serviceURL}>كل {service.nameAr}</a></nav>
</div></header>

<section class="hero"><div class="container">
  <nav class="crumbs" aria-label="مسار التنقل"><a href="/">الرئيسية</a><span>/</span><a href={cityURL}>{city.nameAr}</a><span>/</span><a href={serviceURL}>{service.nameAr}</a></nav>
  <div class="eyebrow"><span aria-hidden="true">{service.icon}</span>{city.regionAr} · دليل السعودية</div>
  <h1>{pageTitle}</h1>
  <p class="lead">{fill(service.introTemplate)}</p>
</div></section>

<main class="container main">
  <div class="layout">
    <section class="panel">
      <h2>{service.slug === 'weather' ? 'توقعات الطقس' : 'النتائج والبيانات المتاحة'}</h2>
      <p class="muted" id="panelIntro">{service.slug === 'weather' ? 'يجري جلب توقعات الطقس من المصدر وعرضها هنا.' : 'تُجلب بيانات الأماكن وتُعرض داخل الموقع. استخدم البحث لتصفية النتائج حسب الاسم أو العنوان.'}</p>

      {service.slug === 'weather' ? (
        <>
          <div class="status" id="weatherStatus" role="status" aria-live="polite"><strong>جارٍ جلب التوقعات...</strong>قد يستغرق جلب بيانات الطقس بضع ثوانٍ.</div>
          <div id="weatherView" hidden>
            <div class="weather-current">
              <div><div id="weatherCity" style="font-size:13px;font-weight:800">{city.nameAr}</div><div class="temperature"><span id="temperature">--</span>°</div><div class="weather-description" id="weatherTime">—</div></div>
              <div class="weather-symbol" id="weatherSymbol" aria-hidden="true">🌤️</div>
            </div>
            <div class="weather-stats">
              <div class="wstat"><strong id="humidity">—</strong><span>الرطوبة</span></div>
              <div class="wstat"><strong id="wind">—</strong><span>الرياح</span></div>
              <div class="wstat"><strong id="rain">—</strong><span>هطول متوقع</span></div>
            </div>
            <h3 style="font-size:15px;margin:21px 0 9px">الساعات القادمة</h3>
            <div class="hourly" id="hourly"></div>
            <p class="notice" id="weatherAttribution"></p>
          </div>
          <button class="refresh" type="button" id="retryWeather" style="margin-top:14px">تحديث التوقعات</button>
        </>
      ) : (
        <>
          <div class="toolbar">
            <input class="search" id="placeSearch" type="search" placeholder="ابحث بالاسم أو العنوان..." aria-label="بحث داخل النتائج" />
            <button class="refresh" id="refreshPlaces" type="button">تحديث النتائج</button>
          </div>
          <div class="filters" id="kindFilters" role="group" aria-label="تصفية نوع المكان"></div>
          <div class="resultsmeta"><span id="resultSummary" aria-live="polite">جارٍ جلب النتائج...</span><span>حتى 100 نتيجة</span></div>
          <div class="status" id="placeStatus" role="status" aria-live="polite"><strong>جارٍ البحث عن الأماكن...</strong>نحمّل بيانات المصدر لهذه المدينة.</div>
          <div class="results" id="placeResults"></div>
          <div class="status" id="noResults" hidden><strong>لا توجد نتائج مطابقة</strong>جرّب عبارة أخرى أو غيّر نوع المكان.</div>
          <p class="notice" id="placesAttribution">مصدر بيانات الأماكن: مساهمو OpenStreetMap. قد لا تتوفر بيانات لكل منشأة أو كل مدينة.</p>
        </>
      )}
    </section>

    <aside class="sidebar">
      <section class="side"><h2>تفاصيل الصفحة</h2>
        <div class="fact"><span>المدينة</span><strong>{city.nameAr}</strong></div>
        <div class="fact"><span>المنطقة</span><strong>{city.regionAr}</strong></div>
        <div class="fact"><span>القسم</span><strong>{service.nameAr}</strong></div>
        <div class="fact"><span>الصفحات المتاحة</span><strong>40 مدينة</strong></div>
        <div class="fact"><span>آخر جلب</span><strong id="fetchedTime">عند الطلب</strong></div>
      </section>
      <section class="side"><h2>تابع استكشاف المدينة</h2><div class="side-links">
        <a href={cityURL}>جميع أقسام {city.nameAr} ←</a>
        <a href={new URL('/city/' + city.slug + '/', Astro.site).toString()}>نبذة ودليل {city.nameAr} ←</a>
      </div></section>
    </aside>
  </div>

  <section class="related"><h2>نبذة عن {city.nameAr}</h2><div class="panel"><p class="muted">{city.overview} تختلف تفاصيل الأماكن وتوافرها حسب البيانات التي أضافها المساهمون. يعرض دليل السعودية ما يستطيع جلبه من المصدر ويبيّن الحالات التي لا تتوفر فيها نتائج.</p></div></section>

  <section class="related"><h2>كيف تُستخدم بيانات هذا الدليل؟</h2><div class="panel">
    {service.slug === 'weather' ? <p class="muted">تُجلب توقعات الطقس وقت فتح الصفحة من خدمة MET Norway Locationforecast، مع تخزين مؤقت لتقليل الطلبات. التوقعات ليست تحذيرًا رسميًا وقد تختلف عن الرصد المحلي.</p> : <p class="muted">تُجلب أسماء الأماكن والعناوين وساعات العمل عند توفرها من OpenStreetMap. قد تكون بعض الحقول غير مكتملة أو قديمة، لذلك لا نفترض أن المكان مفتوح الآن ولا نخترع تقييمات أو بيانات اتصال.</p>}
  </div></section>

  <section class="related"><h2>أسئلة شائعة عن {service.nameAr} في {city.nameAr}</h2><div class="panel">
    <h3 style="font-size:15px;margin:0 0 5px">هل تشمل النتائج جميع الأماكن في {city.nameAr}؟</h3>
    <p class="muted">ليس بالضرورة؛ تعتمد النتائج على ما هو مسجل في المصدر لهذه المنطقة والفئة، وقد لا تشمل كل المنشآت أو أحدث التغييرات.</p>
    <h3 style="font-size:15px;margin:18px 0 5px">هل معلومات ساعات العمل والتواصل مؤكدة؟</h3>
    <p class="muted">تظهر هذه الحقول فقط عندما تكون موجودة في بيانات المصدر. يُنصح بالتحقق من الجهة نفسها قبل الزيارة أو الاعتماد على رقم اتصال.</p>
    <h3 style="font-size:15px;margin:18px 0 5px">من أين تأتي البيانات؟</h3>
    <p class="muted">تُنسب بيانات الأماكن إلى OpenStreetMap وبيانات الطقس إلى MET Norway، وتظهر روابط المصدر والترخيص بجوار النتائج.</p>
  </div></section>

  <section class="related"><h2>أقسام أخرى في {city.nameAr}</h2><div class="linkgrid">
    {relatedServices.map((related) => <a class="linkcard" href={`/directory/${city.slug}/${related.slug}/`}><strong>{related.icon} {related.nameAr}</strong><small>استكشف البيانات المتاحة ←</small></a>)}
  </div></section>

  <section class="related"><h2>مدن أخرى في {city.regionAr}</h2><div class="linkgrid">
    {nearbyCities.map((other) => <a class="linkcard" href={`/directory/${other.slug}/${service.slug}/`}><strong>{other.nameAr}</strong><small>{service.nameAr} ←</small></a>)}
  </div></section>
</main>

<footer><div class="container foot"><span>دليل السعودية · صفحات معلوماتية مستقلة</span><span>البيانات المتاحة قد تكون غير مكتملة؛ راجع المصدر قبل اتخاذ قرار مهم.</span></div></footer>

<script define:vars={{ citySlug: city.slug, serviceSlug: service.slug }}>
const $ = (id) => document.getElementById(id);
const esc = (value) => String(value ?? '');
const localizedNumber = (value, digits = 0) => Number.isFinite(Number(value)) ? new Intl.NumberFormat('ar-SA', { maximumFractionDigits: digits, minimumFractionDigits: digits }).format(Number(value)) : '—';

function symbolIcon(code) {
  const v = (code || '').toLowerCase();
  if (v.includes('thunder')) return '⛈️';
  if (v.includes('snow') || v.includes('sleet')) return '🌨️';
  if (v.includes('rain') || v.includes('drizzle')) return '🌧️';
  if (v.includes('fog')) return '🌫️';
  if (v.includes('cloud')) return v.includes('partly') ? '🌤️' : '☁️';
  if (v.includes('clear') || v.includes('fair')) return '☀️';
  return '🌤️';
}

function formatTime(value, options = { hour: '2-digit', minute: '2-digit' }) {
  try { return new Intl.DateTimeFormat('ar-SA', { timeZone: 'Asia/Riyadh', ...options }).format(new Date(value)); }
  catch { return ''; }
}

async function loadWeather() {
  const status = $('weatherStatus');
  const view = $('weatherView');
  status.hidden = false;
  status.innerHTML = '<strong>جارٍ جلب التوقعات...</strong>نتصل بمصدر بيانات الطقس.';
  view.hidden = true;
  try {
    const response = await fetch('/api/weather?city=' + encodeURIComponent(citySlug), { headers: { Accept: 'application/json' } });
    const data = await response.json();
    if (!response.ok || data.error) throw new Error(data.message || 'تعذر تحميل الطقس.');
    const current = data.current || {};
    $('temperature').textContent = localizedNumber(current.temperature);
    $('weatherSymbol').textContent = symbolIcon(current.symbol);
    $('weatherTime').textContent = 'وقت التوقع: ' + (formatTime(current.time) || '—') + (data.updatedAt ? ' · تحديث المصدر ' + formatTime(data.updatedAt) : '');
    $('humidity').textContent = current.humidity == null ? '—' : localizedNumber(current.humidity) + '%';
    $('wind').textContent = current.windSpeed == null ? '—' : localizedNumber(current.windSpeed, 1) + ' م/ث';
    $('rain').textContent = current.precipitation == null ? '—' : localizedNumber(current.precipitation, 1) + ' مم';
    $('hourly').replaceChildren();
    (data.hourly || []).filter((item, index) => index % 3 === 0).slice(0, 8).forEach((item) => {
      const box = document.createElement('div');
      box.className = 'hour';
      const time = document.createElement('span'); time.textContent = formatTime(item.time);
      const icon = document.createElement('span'); icon.textContent = symbolIcon(item.symbol);
      const temp = document.createElement('strong'); temp.textContent = item.temperature == null ? '—' : localizedNumber(item.temperature) + '°';
      box.append(time, icon, temp); $('hourly').append(box);
    });
    const attribution = $('weatherAttribution');
    attribution.replaceChildren();
    attribution.append(document.createTextNode((data.attribution || 'مصدر الطقس') + ' '));
    const link = document.createElement('a'); link.href = data.attributionUrl || 'https://api.met.no/doc/TermsOfService'; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.textContent = 'تفاصيل الترخيص والمصدر'; link.style.color = 'var(--green2)';
    attribution.append(link);
    $('fetchedTime').textContent = formatTime(data.updatedAt, { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) || 'محدّث';
    status.hidden = true; view.hidden = false;
  } catch (error) {
    status.innerHTML = '<strong>تعذر تحميل بيانات الطقس</strong>' + esc(error.message || 'تحقق من الاتصال ثم حاول مرة أخرى.');
  }
}
if (serviceSlug === 'weather') {
  $('retryWeather').addEventListener('click', loadWeather);
  loadWeather();
} else {
  let allPlaces = [];
  let activeKind = 'all';
  const results = $('placeResults');
  const search = $('placeSearch');
  const filters = $('kindFilters');

  function drawFilters() {
    filters.replaceChildren();
    const kinds = [...new Set(allPlaces.map((p) => p.kindLabel).filter(Boolean))].slice(0, 10);
    [['all','الكل'], ...kinds.map((kind) => [kind, kind])].forEach(([value, label]) => {
      const button = document.createElement('button');
      button.type = 'button'; button.className = 'filter'; button.textContent = label;
      button.setAttribute('aria-pressed', String(activeKind === value));
      button.addEventListener('click', () => { activeKind = value; drawFilters(); drawPlaces(); });
      filters.append(button);
    });
  }

  function drawPlaces() {
    const term = (search.value || '').trim().toLocaleLowerCase('ar');
    const matched = allPlaces.filter((p) => {
      const kindMatches = activeKind === 'all' || p.kindLabel === activeKind;
      const text = [p.name, p.address, p.kindLabel].join(' ').toLocaleLowerCase('ar');
      return kindMatches && (!term || text.includes(term));
    });
    $('resultSummary').textContent = 'عرض ' + localizedNumber(matched.length) + ' من ' + localizedNumber(allPlaces.length) + ' مكان';
    results.replaceChildren();
    $('noResults').hidden = matched.length > 0 || allPlaces.length === 0;
    matched.forEach((place) => {
      const card = document.createElement('article'); card.className = 'place';
      const kind = document.createElement('span'); kind.className = 'kind'; kind.textContent = place.kindLabel || 'مكان';
      const title = document.createElement('h3'); title.textContent = place.name;
      card.append(kind, title);
      if (place.address) { const address = document.createElement('p'); address.textContent = '⌖ ' + place.address; card.append(address); }
      if (place.openingHours) { const hours = document.createElement('p'); hours.textContent = 'ساعات العمل المسجلة: ' + place.openingHours; card.append(hours); }
      if (place.phone) {
        const phone = document.createElement('p'); phone.textContent = 'هاتف: ' + place.phone; card.append(phone);
      }
      const links = document.createElement('div'); links.className = 'details';
      if (place.phone) { const call = document.createElement('a'); call.href = 'tel:' + place.phone.replace(/[^d+]/g, ''); call.textContent = 'اتصال'; links.append(call); }
      if (place.website) { const web = document.createElement('a'); web.href = place.website; web.target = '_blank'; web.rel = 'noopener noreferrer'; web.textContent = 'الموقع الرسمي/المسجل'; links.append(web); }
      if (place.mapUrl) { const map = document.createElement('a'); map.href = place.mapUrl; map.target = '_blank'; map.rel = 'noopener noreferrer'; map.textContent = 'عرض على الخريطة'; links.append(map); }
      if (links.childElementCount) card.append(links);
      results.append(card);
    });
  }

  async function loadPlaces() {
    $('placeStatus').hidden = false;
    $('placeStatus').innerHTML = '<strong>جارٍ جلب الأماكن...</strong>تُحمّل بيانات الخريطة لهذه المدينة.';
    results.replaceChildren(); $('noResults').hidden = true;
    $('refreshPlaces').disabled = true;
    try {
      const response = await fetch('/api/places?city=' + encodeURIComponent(citySlug) + '&service=' + encodeURIComponent(serviceSlug), { headers: { Accept: 'application/json' } });
      const data = await response.json();
      if (!response.ok || data.error) throw new Error(data.message || 'تعذر جلب بيانات الأماكن.');
      allPlaces = data.places || []; activeKind = 'all';
      $('placeStatus').hidden = true;
      $('placesAttribution').replaceChildren(document.createTextNode((data.attribution || 'مصدر البيانات') + ' '));
      if (data.attributionUrl) {
        const link = document.createElement('a'); link.href = data.attributionUrl; link.target = '_blank'; link.rel = 'noopener noreferrer'; link.textContent = 'مصدر البيانات والترخيص'; link.style.color = 'var(--green2)';
        $('placesAttribution').append(link);
      }
      $('fetchedTime').textContent = formatTime(data.fetchedAt, { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) || 'محدّث';
      if (!allPlaces.length) {
        $('placeStatus').hidden = false;
        $('placeStatus').innerHTML = '<strong>لا توجد نتائج مسجلة في المصدر لهذه الفئة حاليًا</strong>قد تكون تغطية البيانات محدودة. جرّب لاحقًا أو ابحث في قسم آخر.';
      }
      drawFilters(); drawPlaces();
    } catch (error) {
      $('placeStatus').hidden = false;
      $('placeStatus').innerHTML = '<strong>تعذر جلب البيانات</strong>' + esc(error.message || 'تحقق من الاتصال ثم حاول مرة أخرى.');
    } finally {
      $('refreshPlaces').disabled = false;
    }
  }
  search.addEventListener('input', drawPlaces);
  $('refreshPlaces').addEventListener('click', loadPlaces);
  loadPlaces();
}
</script>
</body>
</html>
