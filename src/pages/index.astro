---
import cities from '../data/cities.json';
import services from '../data/service-types.json';

const cityCount = cities.length;
const serviceCount = services.length;
const pseoCount = cityCount * serviceCount;
const canonicalURL = Astro.site ? new URL('/', Astro.site).toString() : Astro.url.href;
const popularCities = ['riyadh','jeddah','makkah','medina','dammam','abha','jazan','taif']
  .map((slug) => cities.find((city) => city.slug === slug)).filter(Boolean);
const schema = {
  '@context':'https://schema.org','@type':'WebSite','name':'دليل السعودية','url':canonicalURL,
  'inLanguage':'ar-SA','description':'دليل مدن السعودية والخدمات المحلية مع نتائج بيانات مفتوحة وتوقعات الطقس داخل الموقع.'
};
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="theme-color" content="#123b32"/>
  <title>دليل السعودية | دليل المدن والخدمات والطقس</title>
  <meta name="description" content="استكشف 40 مدينة سعودية و8 فئات من الخدمات. ابحث عن المطاعم والفنادق والصحة والتعليم والتسوق والطقس مع بيانات تُعرض داخل الموقع."/>
  <link rel="canonical" href={canonicalURL}/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <meta property="og:type" content="website"/>
  <meta property="og:locale" content="ar_SA"/>
  <meta property="og:title" content="دليل السعودية | دليل المدن والخدمات والطقس"/>
  <meta property="og:description" content="استكشف مدن المملكة وخدماتها مع صفحات مخصصة وبيانات تُعرض داخل الموقع."/>
  <meta property="og:url" content={canonicalURL}/>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<style>
:root{--g:#123b32;--g2:#1d5a49;--gold:#d7b976;--ink:#172b26;--muted:#66766e;--paper:#f6f8f4;--line:#e0e7df;--mint:#eaf2eb;--white:#fff;--shadow:0 18px 50px rgba(18,59,50,.08)}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:85px}body{margin:0;background:var(--paper);color:var(--ink);font-family:Tahoma,"Segoe UI",Arial,sans-serif;line-height:1.75}a{color:inherit;text-decoration:none}a:focus-visible,input:focus-visible,button:focus-visible{outline:3px solid #b98935;outline-offset:3px}button,input{font:inherit}.container{width:min(1160px,calc(100% - 34px));margin-inline:auto}.header{position:sticky;top:0;z-index:10;background:#ffffffef;backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}.nav{min-height:74px;display:flex;align-items:center;gap:25px}.brand{display:flex;align-items:center;gap:10px;white-space:nowrap;font-size:19px;font-weight:900}.brand-mark{width:41px;height:41px;display:grid;place-items:center;background:var(--g);border-radius:13px;color:#f0dcac;font-size:24px}.brand b{color:var(--g2)}.navlinks{display:flex;gap:23px;margin-inline-start:auto;color:var(--muted);font-size:13px}.navlinks a:hover{color:var(--g2)}.navcta{background:var(--g);color:white;border-radius:11px;padding:10px 15px;font-size:12px;font-weight:800}.hero{position:relative;overflow:hidden;background:var(--g);color:white;padding:65px 0 78px}.hero:before,.hero:after{content:"";position:absolute;border:1px solid #ffffff15;border-radius:50%;pointer-events:none}.hero:before{width:560px;height:560px;left:-230px;top:-300px}.hero:after{width:400px;height:400px;left:-150px;top:-225px}.heroGrid{position:relative;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:44px}.eyebrow{display:inline-flex;align-items:center;gap:9px;color:#ecd9a8;font-size:13px;font-weight:800}.dot{width:7px;height:7px;background:var(--gold);border-radius:100%}h1{font-size:clamp(36px,4.6vw,57px);line-height:1.25;letter-spacing:-1.3px;margin:18px 0}.hero p{max-width:650px;color:#d7e4dc;font-size:16px;margin:0 0 26px}.searchbox{display:flex;gap:8px;background:white;border-radius:14px;padding:7px;max-width:640px;box-shadow:0 18px 40px #031c1533}.searchbox input{flex:1;min-width:0;border:0;background:transparent;padding:11px;color:var(--ink)}.searchbox button{border:0;border-radius:10px;padding:10px 17px;color:white;background:var(--g2);font-weight:800;cursor:pointer}.hint{color:#c5d8cd!important;font-size:11px!important;margin:10px 6px 0!important}.heroVisual{display:grid;place-items:center;min-height:280px;position:relative}.orb{width:300px;height:300px;border-radius:50%;border:1px solid #d7b97660;position:absolute}.orb:before,.orb:after{content:"";position:absolute;inset:25px;border:1px dashed #d7b97655;border-radius:50%}.orb:after{inset:56px}.visualCard{z-index:1;position:relative;width:min(100%,350px);padding:24px;border-radius:24px;background:linear-gradient(145deg,#fff,#ecf2eb);color:var(--ink);box-shadow:0 28px 70px #041c1748;transform:rotate(-2deg)}.visualTop{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:15px}.visualTop small{color:var(--muted);font-size:11px}.visualTop h2{font-size:19px;margin:3px 0}.pin{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:var(--mint);font-size:24px;color:var(--g)}.mapPattern{margin:17px 0;height:95px;border-radius:12px;overflow:hidden;background:#e5eee4}.mapPattern svg{height:100%;width:100%}.visualStats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.vstat{background:white;border:1px solid var(--line);border-radius:10px;padding:9px 4px;text-align:center}.vstat strong{display:block;font-size:18px;color:var(--g)}.vstat span{font-size:10px;color:var(--muted)}.statsWrap{margin-top:-25px;position:relative;z-index:2}.stats{display:grid;grid-template-columns:repeat(3,1fr);background:white;border:1px solid var(--line);box-shadow:var(--shadow);border-radius:17px;padding:18px}.stat{display:flex;align-items:center;justify-content:center;gap:12px;border-left:1px solid var(--line)}.stat:last-child{border-left:0}.statIcon{width:41px;height:41px;border-radius:13px;display:grid;place-items:center;background:var(--mint);font-size:20px}.stat strong{display:block;font-size:22px;line-height:1.3;color:var(--g)}.stat small{font-size:11px;color:var(--muted)}.section{padding:68px 0 0}.sectionHead{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:23px}.kicker{font-size:12px;font-weight:900;color:var(--g2)}.sectionTitle{font-size:clamp(25px,3vw,34px);margin:5px 0 0;line-height:1.4}.sectionSub{font-size:13px;color:var(--muted);margin:8px 0 0;max-width:760px}.categoryGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px}.category{display:flex;gap:13px;align-items:flex-start;background:white;border:1px solid var(--line);border-radius:15px;padding:18px;transition:transform .2s,border-color .2s,box-shadow .2s}.category:hover,.city:hover{border-color:#a9c3ae;transform:translateY(-3px);box-shadow:var(--shadow)}.categoryIcon{flex:0 0 45px;width:45px;height:45px;display:grid;place-items:center;background:var(--mint);border-radius:13px;font-size:22px}.category h3{font-size:14px;margin:1px 0 5px}.category p{font-size:11px;line-height:1.8;color:var(--muted);margin:0}.category span:last-child{display:block;color:var(--g2);font-size:11px;font-weight:900;margin-top:9px}.cityTools{display:flex;gap:10px;align-items:center;margin-bottom:17px}.cityTools input{flex:1;min-width:0;border:1px solid var(--line);border-radius:11px;background:white;padding:12px 14px;color:var(--ink)}.cityCount{font-size:12px;color:var(--muted);white-space:nowrap}.cityGrid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.city{background:white;border:1px solid var(--line);border-radius:14px;padding:15px;transition:transform .2s,border-color .2s,box-shadow .2s}.city strong{display:block;font-size:15px}.city small{display:block;color:var(--muted);font-size:11px;margin-top:3px}.city em{display:block;color:var(--g2);font-size:11px;font-style:normal;font-weight:900;margin-top:11px}.noCities{border:1px dashed var(--line);background:white;text-align:center;border-radius:14px;padding:25px;color:var(--muted);margin-top:12px}.trust{margin:60px 0 70px;display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:center;background:#edf3ed;border:1px solid #dbe6da;border-radius:22px;padding:30px}.trust h2{margin:5px 0 12px;font-size:27px}.trust p{font-size:13px;color:#53655c;margin:0}.trustList{display:grid;grid-template-columns:1fr 1fr;gap:10px}.trustPoint{display:flex;gap:9px;align-items:flex-start;background:white;border:1px solid #e1e9df;border-radius:11px;padding:13px;font-size:11px;color:#53645b}.check{width:23px;height:23px;flex:0 0 23px;display:grid;place-items:center;background:var(--mint);border-radius:7px;color:var(--g2);font-weight:900}footer{background:#102f29;color:#d6e3da;padding:27px 0;font-size:12px}.footer{display:flex;justify-content:space-between;gap:20px;align-items:center;flex-wrap:wrap}.footer strong{color:white;font-size:15px}.footer p{color:#b9cbbf;margin:3px 0 0}.footerLinks{display:flex;gap:18px;flex-wrap:wrap}.footerLinks a:hover{color:white}
@media(max-width:930px){.categoryGrid,.cityGrid{grid-template-columns:repeat(3,minmax(0,1fr))}.heroGrid{gap:25px}.heroVisual{min-height:250px}.visualCard{padding:19px}}
@media(max-width:680px){.container{width:calc(100% - 26px)}.nav{min-height:66px;gap:12px}.brand{font-size:16px}.brand-mark{width:36px;height:36px}.navlinks{display:none}.navcta{margin-inline-start:auto}.hero{padding:46px 0 58px}.heroGrid{grid-template-columns:1fr;gap:16px}.hero h1{font-size:39px}.hero p{font-size:14px}.heroVisual{min-height:240px}.orb{width:240px;height:240px}.visualCard{max-width:315px}.stats{padding:12px 5px}.stat{gap:6px}.statIcon{width:30px;height:30px;font-size:15px}.stat strong{font-size:18px}.stat small{font-size:9px}.section{padding-top:52px}.sectionHead{align-items:flex-start;flex-direction:column;gap:5px}.categoryGrid,.cityGrid{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.category{padding:13px;gap:9px}.categoryIcon{flex-basis:35px;width:35px;height:35px;font-size:18px}.category h3{font-size:12px}.category p{font-size:10px}.city{padding:12px}.city strong{font-size:13px}.city small{font-size:10px}.city em{font-size:10px}.trust{grid-template-columns:1fr;padding:22px;margin:46px 0}.trust h2{font-size:24px}.trustList{gap:7px}.trustPoint{font-size:10px;padding:10px}.footer{align-items:flex-start;flex-direction:column}.searchbox button{padding:9px 12px;font-size:12px}.cityTools{align-items:stretch;flex-direction:column}.cityCount{white-space:normal}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important}}
</style>
</head>
<body>
<header class="header"><div class="container nav">
  <a href="/" class="brand"><span class="brand-mark">س</span><span>دليل <b>السعودية</b></span></a>
  <nav class="navlinks" aria-label="التنقل الرئيسي"><a href="#categories">الأقسام</a><a href="#cities">المدن</a><a href="#about">عن الدليل</a></nav>
  <a class="navcta" href="#cities">اكتشف المدن ←</a>
</div></header>
<main>
<section class="hero"><div class="container heroGrid">
  <div>
    <div class="eyebrow"><span class="dot"></span> دليل رقمي لمدن المملكة</div>
    <h1>كل مدينة،<br/>ومعلوماتها في مكان واحد.</h1>
    <p>استكشف المدن السعودية وابحث داخل أدلة المطاعم والإقامة والصحة والتعليم والخدمات والتسوق والسياحة والطقس. تُجلب البيانات إلى داخل الموقع من مصادر مفتوحة عند توفرها، بدل الاكتفاء بصفحات وروابط خارجية.</p>
    <div class="searchbox" role="search"><input type="search" id="homeSearch" aria-label="ابحث باسم المدينة أو المنطقة" placeholder="ابحث عن مدينة أو منطقة..."/><button type="button" id="searchBtn">ابحث الآن</button></div>
    <p class="hint">جرّب: الرياض، جدة، جازان، المنطقة الشرقية أو عسير</p>
  </div>
  <div class="heroVisual" aria-hidden="true"><div class="orb"></div><div class="visualCard">
    <div class="visualTop"><div><small>دليل واحد، فئات متعددة</small><h2>اكتشف مكانك التالي</h2></div><div class="pin">⌖</div></div>
    <div class="mapPattern"><svg viewBox="0 0 320 95" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M-5 20C37 42 54 3 93 24S138 75 173 49 222 19 246 42 285 73 328 52" stroke="#bed0bd" stroke-width="8" stroke-linecap="round"/><path d="M35 -8C43 21 62 35 55 54S29 80 47 103M132 -8C116 19 148 40 142 60S119 83 132 103M250 -8C230 17 253 36 270 50S274 80 295 103" stroke="#d1dfd0" stroke-width="5" stroke-linecap="round"/><path d="M80 55L129 35L185 61L228 35" stroke="#4f8770" stroke-width="2" stroke-dasharray="4 5"/><circle cx="80" cy="55" r="6" fill="#c5a360" stroke="white" stroke-width="3"/><circle cx="129" cy="35" r="6" fill="#1d5a49" stroke="white" stroke-width="3"/><circle cx="185" cy="61" r="6" fill="#1d5a49" stroke="white" stroke-width="3"/><circle cx="228" cy="35" r="6" fill="#c5a360" stroke="white" stroke-width="3"/></svg></div>
    <div class="visualStats"><div class="vstat"><strong>{cityCount}</strong><span>مدينة</span></div><div class="vstat"><strong>{serviceCount}</strong><span>فئة</span></div><div class="vstat"><strong>{pseoCount}</strong><span>صفحة مدينة/فئة</span></div></div>
  </div></div>
</div></section>
<div class="statsWrap"><div class="container stats"><div class="stat"><span class="statIcon">⌖</span><div><strong>{cityCount}</strong><small>مدينة ومحافظة مدرجة</small></div></div><div class="stat"><span class="statIcon">▦</span><div><strong>{serviceCount}</strong><small>أقسام للخدمات والمعلومات</small></div></div><div class="stat"><span class="statIcon">↗</span><div><strong>{pseoCount}</strong><small>صفحة مخصصة لمدينة وفئة</small></div></div></div></div>

<section class="section" id="categories"><div class="container"><div class="sectionHead"><div><div class="kicker">استكشف ما يهمك</div><h2 class="sectionTitle">اختر نوع الدليل</h2><p class="sectionSub">لكل فئة صفحات مخصصة للمدن الأربعين، ويُعرض المحتوى المتاح داخل الموقع مع بيان مصدر البيانات.</p></div></div>
<div class="categoryGrid">{services.map((service) => <a class="category" href={`/services/${service.slug}/`}><span class="categoryIcon" aria-hidden="true">{service.icon}</span><span><h3>{service.nameAr}</h3><p>{service.descriptionTemplate.replaceAll('{city}','مدن المملكة').replaceAll('{region}','المملكة العربية السعودية')}</p><span>تصفح 40 مدينة ←</span></span></a>)}</div></div></section>

<section class="section" id="cities"><div class="container"><div class="sectionHead"><div><div class="kicker">دليل المدن والمحافظات</div><h2 class="sectionTitle">من أي مدينة تريد أن تبدأ؟</h2><p class="sectionSub">اختر مدينة لتصفح جميع الأقسام الثمانية ونتائج البيانات الحية المتاحة فيها.</p></div></div>
<div class="cityTools"><input type="search" id="citySearch" aria-label="تصفية المدن" placeholder="اكتب اسم المدينة أو المنطقة..."/><span class="cityCount" id="cityCount" aria-live="polite">عرض {cityCount} مدينة</span></div>
<div class="cityGrid" id="cityGrid">{cities.map((city) => <a class="city" href={`/city/${city.slug}/`} data-city-card data-search={(city.nameAr + ' ' + city.regionAr + ' ' + city.overview)}><strong>{city.nameAr}</strong><small>{city.regionAr}</small><em>تصفح المدينة ←</em></a>)}</div>
<div class="noCities" id="noCities" hidden>لم نعثر على مدينة مطابقة. جرّب اسمًا آخر.</div></div></section>

<section class="container trust" id="about"><div><div class="kicker">بناء على بيانات لا على التخمين</div><h2>صفحات أكثر،<br/>وفائدة حقيقية للزائر.</h2><p>يولّد النظام صفحات مستقلة لكل مدينة وفئة، ويجلب بيانات الأماكن من OpenStreetMap وتوقعات الطقس من MET Norway عند فتح الصفحة. قد تكون بيانات الخرائط غير مكتملة؛ لذلك نعرض المصدر بوضوح ولا نخترع تقييمات أو ساعات عمل غير متوفرة.</p></div><div class="trustList"><div class="trustPoint"><span class="check">✓</span><span><b>صفحات pSEO</b><br/>40 صفحة مدينة و320 صفحة مدينة/فئة و8 صفحات فئات.</span></div><div class="trustPoint"><span class="check">✓</span><span><b>بيانات داخل الموقع</b><br/>النتائج تُعرض كبطاقات قابلة للبحث والتصفية.</span></div><div class="trustPoint"><span class="check">✓</span><span><b>مصادر مرئية</b><br/>إسناد بيانات الخرائط والطقس وترخيصها.</span></div><div class="trustPoint"><span class="check">✓</span><span><b>روابط داخلية</b><br/>روابط بين المدينة والفئة والمدن ذات الصلة.</span></div></div></section>
</main>
<footer><div class="container footer"><div><strong>دليل السعودية</strong><p>دليل معلوماتي قيد التوسّع؛ توافر البيانات يختلف حسب المكان والفئة.</p></div><div class="footerLinks"><a href="#categories">الأقسام</a><a href="#cities">المدن</a><a href="/sitemap.xml">خريطة الموقع</a><a href="/services/weather/">الطقس</a></div></div></footer>
<script>
const input=document.getElementById('citySearch');const cards=[...document.querySelectorAll('[data-city-card]')];const count=document.getElementById('cityCount');const empty=document.getElementById('noCities');function filterCities(){const q=input.value.trim().toLocaleLowerCase('ar');let n=0;cards.forEach(card=>{const show=(card.dataset.search||'').toLocaleLowerCase('ar').includes(q);card.hidden=!show;if(show)n++});count.textContent='عرض '+n+' من '+cards.length+' مدينة';empty.hidden=n>0}input.addEventListener('input',filterCities);document.getElementById('searchBtn').addEventListener('click',()=>{input.value=document.getElementById('homeSearch').value;filterCities();document.getElementById('cities').scrollIntoView({behavior:'smooth'})});document.getElementById('homeSearch').addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();document.getElementById('searchBtn').click()}});
</script>
</body></html>
