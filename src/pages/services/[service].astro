---
import cities from '../../data/cities.json';
import services from '../../data/service-types.json';

export function getStaticPaths() {
  return services.map((service) => ({ params: { service: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const canonicalURL = new URL(`/services/${service.slug}/`, Astro.site).toString();
const description = service.descriptionTemplate.replaceAll('{city}', 'مدن المملكة').replaceAll('{region}', 'المملكة العربية السعودية');
const homeURL = new URL('/', Astro.site).toString();
const schema = {'@context':'https://schema.org','@type':'CollectionPage',name:`${service.nameAr} في مدن السعودية | دليل السعودية`,description,url:canonicalURL,inLanguage:'ar-SA',numberOfItems:cities.length};
---
<!doctype html>
<html lang="ar" dir="rtl">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#123b32"/>
<title>{service.nameAr} في مدن السعودية | دليل السعودية</title><meta name="description" content={description}/><link rel="canonical" href={canonicalURL}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<meta property="og:type" content="website"/><meta property="og:locale" content="ar_SA"/><meta property="og:title" content={`${service.nameAr} في مدن السعودية | دليل السعودية`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonicalURL}/><script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
<style>:root{--g:#123b32;--g2:#1d5a49;--paper:#f6f8f4;--ink:#182c26;--muted:#63736b;--line:#e0e7df;--mint:#eaf2eb}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Tahoma,"Segoe UI",Arial,sans-serif;line-height:1.8}a{color:inherit;text-decoration:none}.container{width:min(1100px,calc(100% - 32px));margin:auto}.header{background:#fff;border-bottom:1px solid var(--line)}.nav{height:70px;display:flex;justify-content:space-between;align-items:center}.brand{font-size:18px;font-weight:800;display:flex;gap:10px;align-items:center}.mark{background:var(--g);color:#efdba8;border-radius:12px;width:39px;height:39px;display:grid;place-items:center;font-size:23px}.brand b{color:var(--g2)}.hero{background:var(--g);color:#fff;padding:42px 0}.eyebrow{color:#e8d7a5;font-size:13px;font-weight:800}.hero h1{font-size:clamp(28px,4vw,42px);margin:10px 0}.hero p{color:#d7e4dc;margin:0;max-width:800px;font-size:14px}.main{padding:30px 0 65px}.tools{display:flex;gap:10px;margin-bottom:20px}.search{flex:1;min-width:0;background:#fff;border:1px solid var(--line);border-radius:12px;padding:12px 14px;font:inherit}.count{font-size:12px;color:var(--muted);align-self:center}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;transition:transform .18s,border-color .18s}.card:hover{transform:translateY(-2px);border-color:#adc5b2}.card strong{font-size:15px;display:block}.card small{font-size:11px;color:var(--muted);display:block;margin-top:4px}.card span{color:var(--g2);font-weight:800;font-size:12px;display:block;margin-top:12px}.empty{background:#fff;border:1px dashed var(--line);border-radius:14px;padding:22px;text-align:center;color:var(--muted);margin-top:12px}footer{background:#102f29;color:#d7e4dc;padding:22px 0;font-size:12px}@media(max-width:820px){.grid{grid-template-columns:repeat(2,minmax(0,1fr)}}@media(max-width:450px){.grid{grid-template-columns:1fr 1fr;gap:8px}.card{padding:12px}.container{width:calc(100% - 24px)}}}</style>
</head>
<body><header class="header"><div class="container nav"><a class="brand" href="/"><span class="mark">س</span><span>دليل <b>السعودية</b></span></a><a href="/" style="font-size:13px;color:var(--g2)">الرئيسية ←</a></div></header>
<section class="hero"><div class="container"><div class="eyebrow">{service.icon} دليل الخدمات في المملكة</div><h1>{service.nameAr} في مدن السعودية</h1><p>{service.introTemplate.replaceAll('{city}', 'مدن المملكة').replaceAll('{region}', 'مناطق المملكة')} يتضمن الدليل 40 مدينة و40 صفحة مخصصة لهذه الفئة، ويعرض البيانات المتاحة داخل الصفحة عند فتحها.</p></div></section>
<main class="container main"><div class="tools"><input class="search" id="citySearch" type="search" placeholder="ابحث باسم المدينة أو المنطقة..." aria-label="ابحث باسم المدينة"/><span class="count" id="cityCount" aria-live="polite">40 مدينة</span></div>
<div class="grid" id="cityGrid">{cities.map((city) => <a class="card" href={`/directory/${city.slug}/${service.slug}/`} data-city-card data-search={(city.nameAr + ' ' + city.regionAr)}><strong>{city.nameAr}</strong><small>{city.regionAr}</small><span>استكشف {service.nameAr} ←</span></a>)}</div>
<div class="empty" id="emptyCity" hidden>لم نعثر على مدينة مطابقة.</div></main><footer><div class="container">دليل السعودية · تحقّق من بيانات الجهة ومصدرها قبل الاعتماد عليها.</div></footer>
<script>const q=document.getElementById('citySearch');const cards=[...document.querySelectorAll('[data-city-card]')];const count=document.getElementById('cityCount');const empty=document.getElementById('emptyCity');function filter(){const v=q.value.trim().toLocaleLowerCase('ar');let n=0;cards.forEach(c=>{const show=(c.dataset.search||'').toLocaleLowerCase('ar').includes(v);c.hidden=!show;if(show)n++});count.textContent=n+' مدينة';empty.hidden=n>0}q.addEventListener('input',filter);</script>
</body></html>
